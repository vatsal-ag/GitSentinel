{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/app", "destination": "/dashboard.html" },
    { "source": "/download/macos", "destination": "/src/gui/static/downloads/GitSentinel-macOS.zip" },
    { "source": "/download/windows", "destination": "/src/gui/static/downloads/GitSentinel-Windows.zip" },
    { "source": "/download/linux", "destination": "/src/gui/static/downloads/GitSentinel-Linux.tar.gz" },
    { "source": "/manifest.json", "destination": "/src/gui/static/manifest.json" },
    { "source": "/robots.txt", "destination": "/src/gui/static/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/src/gui/static/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/src/gui/static/llms.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
