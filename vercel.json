{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/app", "destination": "/dashboard.html" },
    { "source": "/download/macos", "destination": "/src/gui/static/downloads/LogSentry-macOS.zip" },
    { "source": "/download/windows", "destination": "/src/gui/static/downloads/LogSentry-Windows.zip" },
    { "source": "/download/linux", "destination": "/src/gui/static/downloads/LogSentry-Linux.tar.gz" },
    { "source": "/brag.mp4", "destination": "/brag.mp4" },
    { "source": "/brag.jpg", "destination": "/brag.jpg" },
    { "source": "/static/brag.mp4", "destination": "/brag.mp4" },
    { "source": "/static/brag.jpg", "destination": "/brag.jpg" },
    { "source": "/manifest.json", "destination": "/src/gui/static/manifest.json" },
    { "source": "/robots.txt", "destination": "/src/gui/static/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/src/gui/static/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/src/gui/static/llms.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https:; media-src 'self' data:; connect-src 'self' http://localhost:8000; frame-ancestors 'none';" }
      ]
    }
  ]
}
